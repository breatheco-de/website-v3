# =============================================================================
# Environment template for mdc-website-v3
# =============================================================================
#
# Setup:
#   cp .env.example .env
#   # Edit .env with real values (never commit .env)
#
#   npm install
#   npm run db:push    # requires DATABASE_URL
#   npm run dev        # http://localhost:5000 (default PORT)
#
# Vite exposes only variables prefixed with VITE_ to the browser bundle.
# All other variables are server-side (Express / scripts).
# =============================================================================

# -----------------------------------------------------------------------------
# Core (local development)
# -----------------------------------------------------------------------------

# HTTP port for Express + Vite (default: 5000)
PORT=5000

# Public site URL for sitemaps, canonical links, hreflang, Lighthouse admin, webhooks
# Local: http://localhost:5000
SITE_URL=http://localhost:5000

# PostgreSQL connection string (Neon or any Postgres)
# Required for: npm run db:push, AI chat conversations, AI knowledge admin
# Optional for: browsing marketing pages without chat/DB features
DATABASE_URL=postgresql://user:password@localhost:5432/mdc_website

# -----------------------------------------------------------------------------
# Breathecode auth (content editing / debug panel)
# -----------------------------------------------------------------------------
# Login flow uses Breathecode tokens with webmaster capability.
# Dev: set VITE_BREATHECODE_TOKEN to skip manual login, or use ?token= in URL.

# API host (server reads this; default shown)
VITE_BREATHECODE_HOST=https://breathecode.herokuapp.com

# Academy API token (blog_posts, upcoming_cohorts DB sources)
# BREATHECODE_ACADEMY_TOKEN=

# Optional: personal API token for local editing (exposed to client if set)
# VITE_BREATHECODE_TOKEN=

# -----------------------------------------------------------------------------
# GitHub content sync (optional)
# -----------------------------------------------------------------------------
# Enables pushing/pulling marketing-content via the debug panel.

# Personal access token with repo write access
# GITHUB_TOKEN=

# Repository URL (HTTPS), e.g. https://github.com/org/mdc-website-v3.git
# GITHUB_REPO_URL=

# Branch to sync (default: main)
# GITHUB_BRANCH=main

# Master switch for GitHub integration
# GITHUB_SYNC_ENABLED=true

# Auto-commit local edits on an interval (requires GITHUB_SYNC_ENABLED=true)
# GITHUB_AUTO_COMMIT_ENABLED=true

# Auto-pull on startup and via webhook (requires GITHUB_SYNC_ENABLED=true)
# GITHUB_AUTO_PULL_ENABLED=true

# -----------------------------------------------------------------------------
# AI / LLM (optional)
# -----------------------------------------------------------------------------
# Provider keys are read from env names in marketing-content/llm.yml
# (default: GROQ_API_KEY, GROQ_BASE_URL). OpenAI-style vars also work.

# GROQ_API_KEY=
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# OPENAI_API_KEY=
# OPENAI_BASE_URL=

# Replit / hosted OpenAI integration aliases
# AI_INTEGRATIONS_OPENAI_API_KEY=
# AI_INTEGRATIONS_OPENAI_BASE_URL=

# Override models from llm.yml (optional)
# LLM_MODEL=
# LLM_CHAT_MODEL=

# -----------------------------------------------------------------------------
# Cloudflare Turnstile (optional, lead forms)
# -----------------------------------------------------------------------------

# Dev test keys (always pass): https://developers.cloudflare.com/turnstile/troubleshooting/testing/
# TURNSTILE_SITE_KEY=1x00000000000000000000AA
# TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# -----------------------------------------------------------------------------
# Media storage — Google Cloud Storage (optional)
# -----------------------------------------------------------------------------
# Default storage is local (marketing-content/images/).
# See README.md for bucket setup.

# GCS_BUCKET_NAME=
# GCS_PROJECT_ID=
# GCS_CREDENTIALS_JSON={"type":"service_account",...}
# GCS_KEY_FILENAME=/path/to/service-account.json
# GCS_BASE_PATH=media
# MEDIA_DEFAULT_PROVIDER=local

# -----------------------------------------------------------------------------
# Geo / analytics helpers (optional)
# -----------------------------------------------------------------------------

# ip-api.com pro key for /api/geo (server-side geolocation)
# IPAPI_PRO_KEY=

# Google PageSpeed Insights API key (Lighthouse admin + validation)
# GOOGLE_PSI_API_KEY=

# -----------------------------------------------------------------------------
# Development / debugging (optional)
# -----------------------------------------------------------------------------

# NODE_ENV=development

# Verbose image crop/resize logging
# DEBUG_CROP_RESIZE=true

# -----------------------------------------------------------------------------
# Replit deployment (optional — omit for pure local dev)
# -----------------------------------------------------------------------------

# REPL_ID=
# REPLIT_DEV_DOMAIN=your-app.replit.dev
