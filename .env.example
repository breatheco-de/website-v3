# ─── MCP Server ───────────────────────────────────────────────────────────────

# REQUIRED. Internal loopback credential used exclusively by the MCP server to
# authenticate its own server-to-server requests to the main app's
# /api/auth/check-capability endpoint. It is NOT accepted as an inbound caller
# credential — callers must use OAuth or a Breathecode token.
# The server will exit with a FATAL error at startup if this is not set.
MCP_SERVER_SECRET=change-me-to-a-long-random-string

# LEGACY ALIAS — rename to MCP_SERVER_SECRET for new deployments.
# A deprecation warning is emitted at startup when only this is set.
# MCP_API_KEY=change-me-to-a-long-random-string

# Port the MCP server listens on (default: 3001).
# MCP_PORT=3001

# Required for GCS-backed MCP OAuth persistence across redeploys (production).
# Generate once: openssl rand -hex 32  (64-character hex string)
# See docs/runbooks/mcp-oauth-persistence.md
# MCP_TOKEN_ENCRYPTION_KEY=

# ─── OAuth (optional — only needed for the legacy static-client OAuth flow) ───

# Static OAuth Client ID/Secret for a pre-registered client.
# Not required when using Claude.ai dynamic client registration (RFC 7591).
# OAUTH_CLIENT_ID=
# OAUTH_CLIENT_SECRET=

# ─── App / deployment ─────────────────────────────────────────────────────────

# Public base URL advertised in OAuth metadata and used for canonical URLs.
# On Replit this is auto-resolved from REPLIT_DEV_DOMAIN — only set it here
# when deploying outside Replit or when you need to force a specific URL.
# SITE_URL=https://your-project.replit.app

# Port the main Express app listens on (default: 5000).
# PORT=5000

# ─── Sidequest job dashboard (staff proxy) ────────────────────────────────────
#
# Sidequest UI is proxied at same-origin /admin/sidequest (webmasters only).
# Open via Agent Pipeline → Agent engine → Sidequest dashboard.
# Raw dashboard listens on SIDEQUEST_DASHBOARD_PORT (default 8678) — keep private;
# Express injects internal Basic auth after staff cookie gate.
#
# Kill switch (unset or true = enabled):
# SIDEQUEST_DASHBOARD_ENABLED=true
# SIDEQUEST_DASHBOARD_PORT=8678
# Optional explicit Basic auth for the raw port (else derived from SESSION_SECRET):
# SIDEQUEST_DASHBOARD_USER=
# SIDEQUEST_DASHBOARD_PASSWORD=

# ─── GitHub content repo sync ─────────────────────────────────────────────────
#
# Each site that runs this platform has its own CONTENT-ONLY GitHub repository.
# GITHUB_REPO_URL should point to that content repo — NOT to the platform code
# repo.  The marketing-content/ folder is gitignored from the platform repo and
# is populated at runtime by pulling from GITHUB_REPO_URL.
#
# On first start with an empty marketing-content/ folder the server automatically
# runs a full bootstrap pull before the normal reconcile/auto-pull logic starts.
# You can also trigger a bootstrap manually:
#   ./scripts/content-bootstrap.sh
#
# To seed a new content repo from an existing folder:
#   ./scripts/content-push-all.sh
#
# See docs/multi-site.md for the full multi-site setup walkthrough.

# URL of the content-only GitHub repository for this site.
# GITHUB_REPO_URL=https://github.com/your-org/your-site-content

# Personal access token with `repo` and `admin:repo_hook` scopes.
# GITHUB_TOKEN=

# Branch to sync against (default: main).
# GITHUB_BRANCH=main

# Content folder names are configured per site in sites.yml (content_folder).
# Do not set CONTENT_FOLDER — it is deprecated.

# Enable GitHub content sync (auto-commit + auto-pull + webhooks).
# GITHUB_SYNC_ENABLED=true

# Automatically pull non-conflicting remote changes on startup and via webhook.
# GITHUB_AUTO_PULL_ENABLED=true

# Automatically commit local editor saves to the content repo.
# GITHUB_AUTO_COMMIT_ENABLED=true

# Soft pull ("Pull only changed" / startup bootstrap) switches from per-file
# downloads to a single repo tarball when more than this many files differ.
# Default: 20. Set lower to prefer the archive path sooner; higher to prefer per-file.
# GITHUB_SOFT_PULL_ARCHIVE_THRESHOLD=20

# ─── GitHub Connect (per-user commits via GitHub App OAuth) ─────────────────────
#
# In production with GITHUB_SYNC_ENABLED=true, staff/MCP commits require Connect.
# For local testing of the Connect UI / commit gate, set:
# GITHUB_CONNECT_REQUIRED=true
#
# Create a GitHub App with Contents: Read and write, install on the content org,
# callback: ${SITE_URL}/api/github/oauth/callback
# GITHUB_APP_CLIENT_ID=
# GITHUB_APP_CLIENT_SECRET=
# GITHUB_APP_SLUG=

# ─── Cloudflare Turnstile (optional — bot protection on lead forms) ─────────────
#
# Both keys are required for Turnstile to work. Create a widget at
# dash.cloudflare.com → Turnstile. On Replit you can set these as Secrets instead.
# When unset, lead forms still work but skip the bot challenge.

# Public site key embedded in the browser widget.
# TURNSTILE_SITE_KEY=

# Secret key validated server-side at /api/turnstile/verify.
# TURNSTILE_SECRET_KEY=

# ─── IP Normalization proxy (/ipn/{id}/*) ──────────────────────────────────────
#
# Shared secret for X-IPN-Token. Env only — never written to settings.yml.
# Tracking → IP Normalization shows configured status; Generate & copy does not save.
# Enable + destinations still live in settings.yml under optimization.ip_normalization.
# IPN_SECRET=

# ─── Cloudflare Browser Run (entry-preview / OG screenshots) ───────────────────
#
# Server-side OG captures navigate a signed EntryPreviewFrame URL via Cloudflare.
# SITE_URL must be publicly reachable (not localhost unless you use a tunnel).
# Token needs "Browser Rendering - Edit" permission.
#
# These are env-only (never written to settings.yml / content GitHub).
# Debug Bubble → Settings → SEO/GEO → OG Image shows configured status and can
# run a throwaway test screenshot; it cannot set or clear these values.
# Rate pacing (min interval, concurrency, 429 retries) is configured on that
# same OG Image tab and stored in settings.yml → entry_preview (not env).
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
# Optional dedicated HMAC secret for capture frame URLs (falls back to SESSION_SECRET).
# ENTRY_PREVIEW_CAPTURE_SECRET=

# ─── AI / LLM (OpenRouter) ────────────────────────────────────────────────────
#
# The platform uses an OpenAI-compatible client. Which key/base URL it reads is
# controlled by site_*/llm.yml (provider.api_key_env / provider.base_url_env).
# Current defaults point at OpenRouter. Completion model can also be chosen in
# Debug Bubble → AI & Agents → AI Settings (/private/settings/ai/llms).
#
# Features enabled when a key is set: field mapping auto-detect, content
# adaptation, table builders, chat assistant, image auto-tagging.
# Get a key at https://openrouter.ai/keys

# Required for AI. Named by llm.yml as provider.api_key_env.
# OPENROUTER_API_KEY=

# OpenRouter API base URL. Soft-defaults to https://openrouter.ai/api/v1 when
# unset and llm.yml names OPENROUTER_BASE_URL.
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional model overrides (take precedence over llm.yml model.default / model.chat).
# Prefer setting models in AI Settings (/private/settings/ai/llms) which writes llm.yml.
# LLM_MODEL=openai/gpt-4o-mini
# LLM_CHAT_MODEL=openai/gpt-4o

# Qdrant vector store for private-database semantic search (default http://localhost:6333).
# Status UI: /private/settings/ai/qdrant
# QDRANT_URL=http://localhost:6333

# ─── Google PageSpeed Insights (optional — SEO Lighthouse panel) ────────────────
#
# Free API key from Google Cloud Console (PageSpeed Insights API).
# Used by the admin SEO diagnostics panel to fetch Core Web Vitals scores.
# Also set SITE_URL so the panel knows which URL to audit.
# Without this key the panel still loads but PSI rate limits are much lower.

# GOOGLE_PSI_API_KEY=

# ─── Google Search Console URL Inspection (optional) ───────────────────────────
#
# Staff diagnostics cache Search Console index status (read-only). This is NOT
# the Indexing API and does not request re-index. Quota is ~2000 inspects/day.
# The Search Console property is settings.yml → search_console.site_url (staff
# SEO/GEO → Search Console).
#
# Credentials: same service account as media — GCS_CREDENTIALS_JSON or
# GCS_KEY_FILENAME. Add that client_email as a user on the Search Console
# property. Optional GSC_CREDENTIALS_JSON / GSC_KEY_FILENAME override those.

# ─── Google Cloud Storage (optional — cloud media instead of local files) ───────
#
# When GCS_BUCKET_NAME is set, uploaded media can be stored in a GCS bucket
# instead of the local site images/ folder. The bucket name can also come from
# sites.yml (bucket_name); the env var is a legacy fallback.
#
# Provide credentials via GCS_KEY_FILENAME (path to a JSON key file) OR
# GCS_CREDENTIALS_JSON (inline JSON string) — use one, not both.
# See README.md for the full GCS setup walkthrough.

# Name of the GCS bucket (e.g. my-project-media). Activates GCS when set.
# GCS_BUCKET_NAME=

# Google Cloud project ID. Usually auto-detected from the service-account key.
# GCS_PROJECT_ID=

# Filesystem path to a service-account JSON key file.
# GCS_KEY_FILENAME=

# Inline JSON string of the service-account credentials (useful on Replit).
# GCS_CREDENTIALS_JSON=

# Folder prefix inside the bucket for media files (default: media).
# GCS_BASE_PATH=media

# Default upload target: "local" (filesystem) or "gcs". Requires GCS_BUCKET_NAME
# when set to gcs.
# MEDIA_DEFAULT_PROVIDER=local

